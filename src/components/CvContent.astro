---
import type { Lang, ExperienceData, EducationData } from '@/types';
import { t, getLocalized } from '@/i18n';
import { inlineMarkdown } from '@/utils/markdown';
import aboutData from '@/data/about/main.json';
import skillsData from '@/data/skills.json';
import p from '@/data/profile/main.json';
import { type ProjectData } from './ProjectCard.astro';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const experienceFiles = import.meta.glob<{ default: ExperienceData }>('@/data/experience/*.json', { eager: true });
const educationFiles = import.meta.glob<{ default: EducationData }>('@/data/education/*.json', { eager: true });

const experience = Object.values(experienceFiles).map((mod) => mod.default);
const education = Object.values(educationFiles).map((mod) => mod.default);
const projectFiles = import.meta.glob<{ default: ProjectData }>('@/data/projects/*.json', { eager: true });
const projects = Object.values(projectFiles).map((mod) => mod.default);
experience.sort((a, b) => a.order - b.order);
education.sort((a, b) => a.order - b.order);
projects.sort((a, b) => a.order - b.order);

function formatDate(value: string | null) {
  if (!value) return t(lang, 'experience.current');
  const [year, month] = value.split('-');
  return new Date(Number(year), Number(month) - 1).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', { year: 'numeric', month: 'short' });
}
---
<article class="cv-card mx-auto max-w-4xl px-6 py-10 md:py-12">
  <header class="mb-8 border-b border-slate-400 pb-6 dark:border-slate-700">
    <div class="flex flex-col items-center gap-6 md:flex-row md:items-start md:text-left print:flex-row print:items-start print:text-left">
      <div class="initials-circle flex h-24 w-24 shrink-0 items-center justify-center overflow-hidden rounded-full bg-accent-600 md:h-28 md:w-28">
        <img src="/profile.jpg" alt={`Foto de ${p.name}`} class="h-full w-full object-cover" />
      </div>
      <div class="flex-1 text-center md:text-left print:text-left">
        <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100 md:text-4xl">{p.name}</h1>
        <p class="mt-1 text-lg font-medium text-slate-700 dark:text-slate-300">{getLocalized(p.role, lang)}</p>
        <p class="mt-1 text-sm text-slate-700 dark:text-slate-400">{getLocalized(p.location, lang)}</p>
        <div class="mt-3 flex flex-wrap items-center justify-center gap-x-4 gap-y-1.5 md:justify-start print:justify-start text-sm">
          <a href={`mailto:${p.email}`} class="flex items-center gap-1.5 font-medium text-accent-700 hover:text-accent-800 hover:underline dark:text-accent-300 dark:hover:text-accent-200">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            {p.email}
          </a>
          <a href={p.links.linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 font-medium text-accent-700 hover:text-accent-800 hover:underline dark:text-accent-300 dark:hover:text-accent-200">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            linkedin.com/in/jlerga
          </a>
          <a href={p.links.github} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 font-medium text-accent-700 hover:text-accent-800 hover:underline dark:text-accent-300 dark:hover:text-accent-200">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.419-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            github.com/Rivet92
          </a>
        </div>
      </div>
    </div>
  </header>

  <section class="mb-8">
    <h2 class="mb-3 text-xl font-bold uppercase tracking-wide text-slate-900 dark:text-slate-100">{t(lang, 'cv.summary')}</h2>
    <p class="text-justify text-slate-700 dark:text-slate-300">{getLocalized(aboutData.paragraphs[0], lang)} {getLocalized(aboutData.paragraphs[1], lang)}</p>
  </section>

  <section class="mb-8">
    <h2 class="mb-4 text-xl font-bold uppercase tracking-wide text-slate-900 dark:text-slate-100">{t(lang, 'cv.experience')}</h2>
    <div class="space-y-6">
      {experience.map((item) => (
        <div class="cv-card">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100">{getLocalized(item.role, lang)} · {item.company}</h3>
            <span class="text-sm text-slate-700 dark:text-slate-400">{formatDate(item.start)} — {formatDate(item.end)}</span>
          </div>
          <p class="text-sm italic text-slate-700 dark:text-slate-400">{t(lang, 'experience.client')}: {getLocalized(item.client, lang)} · {getLocalized(item.mode, lang)}</p>
          <p class="mt-2 text-justify text-sm text-slate-700 dark:text-slate-300">{getLocalized(item.summary, lang)}</p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            {item.stack.map((tech) => (
              <span class="text-xs text-slate-700 dark:text-slate-400">{tech}{item.stack.indexOf(tech) < item.stack.length - 1 ? ',' : ''}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="mb-8">
    <h2 class="mb-4 text-xl font-bold uppercase tracking-wide text-slate-900 dark:text-slate-100">{t(lang, 'cv.education')}</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {education.map((item) => (
        <div class="cv-card">
          <h3 class="font-bold text-slate-900 dark:text-slate-100">{getLocalized(item.degree, lang)}</h3>
          <p class="text-sm text-slate-700 dark:text-slate-400">{getLocalized(item.school, lang)}</p>
          <p class="text-sm text-slate-700 dark:text-slate-700">{formatDate(item.start)}{item.start !== item.end ? ` — ${formatDate(item.end)}` : ''}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mb-8">
    <h2 class="mb-4 text-xl font-bold uppercase tracking-wide text-slate-900 dark:text-slate-100">{t(lang, 'cv.projects')}</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {projects.map((project) => (
        <div class="cv-card">
          <h3 class="font-bold text-slate-900 dark:text-slate-100">{getLocalized(project.title, lang)}</h3>
          <p class="mt-1 text-justify text-sm text-slate-700 dark:text-slate-300" set:html={inlineMarkdown(getLocalized(project.description, lang))}></p>
          {project.link && (
            <a href={project.link} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-sm font-semibold text-accent-700 hover:underline dark:text-accent-300">
              <span class="print:hidden">{getLocalized(project.linkLabel!, lang)}</span>
              <span class="hidden break-all print:inline">{project.link}</span>
            </a>
          )}
        </div>
      ))}
    </div>
  </section>

  <section class="mb-8">
    <h2 class="mb-4 text-xl font-bold uppercase tracking-wide text-slate-900 dark:text-slate-100">{t(lang, 'cv.languages')}</h2>
    <p class="text-sm text-slate-700 dark:text-slate-300">{p.languages.map((item) => getLocalized(item, lang)).join(' · ')}</p>
  </section>

  <section class="mb-8">
    <h2 class="mb-4 text-xl font-bold uppercase tracking-wide text-slate-900 dark:text-slate-100">{t(lang, 'cv.skills')}</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {skillsData.categories.map((category) => (
        <div>
          <h3 class="mb-1 font-semibold text-slate-900 dark:text-slate-100">{getLocalized(category.name, lang)}</h3>
          <p class="text-sm text-slate-700 dark:text-slate-300">{category.items.map((item) => getLocalized(item, lang)).join(', ')}</p>
        </div>
      ))}
    </div>
  </section>
</article>

<script is:inline>
  (function() {
    const stored = localStorage.getItem('theme');
    const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const theme = stored || (systemDark ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', theme);
  })();
</script>

<style>
  @media print {
    article.cv-card {
      break-inside: auto;
    }
    section {
      break-inside: auto;
    }
    a {
      color: var(--color-accent-600) !important;
      text-decoration: none !important;
    }
    .initials-circle {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
      color: var(--color-slate-50) !important;
    }
    h2 {
      color: var(--color-accent-600) !important;
    }
  }
</style>