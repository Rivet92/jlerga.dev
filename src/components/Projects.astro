---
import type { Lang } from '@/types';
import { t } from '@/i18n';
import Section from './Section.astro';
import ProjectCard, { type ProjectData } from './ProjectCard.astro';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const projectFiles = import.meta.glob<{ default: ProjectData }>('@/data/projects/*.json', { eager: true });
const projects = Object.values(projectFiles).map((mod) => mod.default);
projects.sort((a, b) => a.order - b.order);
const lastProject = projects[projects.length - 1];
const firstProject = projects[0];
---
<Section id="projects" title={t(lang, 'projects.title')}>
  <div
    id="projects-track"
    class="flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    role="region"
    aria-label={t(lang, 'projects.title')}
  >
    <ProjectCard project={lastProject} lang={lang} ariaHidden />
    <ProjectCard project={lastProject} lang={lang} ariaHidden />
    {projects.map((project) => (
      <ProjectCard project={project} lang={lang} />
    ))}
    <ProjectCard project={firstProject} lang={lang} ariaHidden />
    <ProjectCard project={firstProject} lang={lang} ariaHidden />
  </div>

  <div class="mt-6 flex items-center justify-between">
    <button
      type="button"
      id="projects-prev"
      class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-300 text-slate-700 hover:bg-accent-100 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-slate-900"
      aria-label={t(lang, 'projects.prev')}
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
    </button>

    <div class="flex items-center gap-2" id="projects-dots"></div>

    <button
      type="button"
      id="projects-next"
      class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-300 text-slate-700 hover:bg-accent-100 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-slate-900"
      aria-label={t(lang, 'projects.next')}
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </button>
  </div>
</Section>

<script>
  const track = document.getElementById('projects-track') as HTMLElement;
  const prevBtn = document.getElementById('projects-prev') as HTMLButtonElement;
  const nextBtn = document.getElementById('projects-next') as HTMLButtonElement;
  const dotsContainer = document.getElementById('projects-dots') as HTMLElement;
  if (!track || !prevBtn || !nextBtn || !dotsContainer) throw new Error('Projects carousel elements not found');

  const cards = Array.from(track.querySelectorAll<HTMLElement>('article'));
  const realCount = cards.length - 4;
  const lastIndex = cards.length - 1;
  const lastReal = realCount + 1; // DOM index of last real card
  const cloneLast = 1;            // DOM index of clone of last real card
  const cloneFirst = realCount + 2; // DOM index of clone of first real card

  let currentReal = 0;
  let animating: number | null = null;

  const dots = Array.from({ length: realCount }, (_, i) => {
    const dot = document.createElement('button');
    dot.type = 'button';
    dot.setAttribute('aria-label', `${i + 1}`);
    dot.className = 'h-2 w-2 rounded-full bg-slate-300 transition dark:bg-slate-700';
    dot.addEventListener('click', () => {
      const delta = i - currentReal;
      for (let s = 0; s < Math.abs(delta); s++) {
        delta > 0 ? goNext() : goPrev();
      }
    });
    dotsContainer.appendChild(dot);
    return dot;
  });

  function geometry() {
    const w = cards[0].offsetWidth;
    const step = cards[1].offsetLeft - cards[0].offsetLeft;
    return { w, step, client: track.clientWidth };
  }

  function snapLeft(domIdx: number) {
    const { w, step, client } = geometry();
    return domIdx * step + w / 2 - client / 2;
  }

  function nearestIdx(pos: number) {
    const { w, step, client } = geometry();
    return Math.round((pos - w / 2 + client / 2) / step);
  }

  function goNext() {
    if (animating !== null) return;
    if (currentReal === realCount - 1) {
      animating = snapLeft(cloneFirst);
      track.scrollTo({ left: animating, behavior: 'smooth' });
      currentReal = 0;
    } else {
      animating = snapLeft(currentReal + 3);
      track.scrollTo({ left: animating, behavior: 'smooth' });
      currentReal = currentReal + 1;
    }
  }

  function goPrev() {
    if (animating !== null) return;
    if (currentReal === 0) {
      animating = snapLeft(cloneLast);
      track.scrollTo({ left: animating, behavior: 'smooth' });
      currentReal = realCount - 1;
    } else {
      animating = snapLeft(currentReal + 1);
      track.scrollTo({ left: animating, behavior: 'smooth' });
      currentReal = currentReal - 1;
    }
  }

  function teleport(domIdx: number, realIdx: number) {
    track.scrollTo({ left: snapLeft(domIdx), behavior: 'instant' });
    currentReal = realIdx;
  }

  function update() {
    dots.forEach((dot, i) => {
      const active = i === currentReal;
      dot.classList.toggle('bg-accent-600', active);
      dot.classList.toggle('bg-slate-300', !active);
      dot.classList.toggle('dark:bg-accent-400', active);
      dot.classList.toggle('dark:bg-slate-700', !active);
    });
  }

  function applyDepth() {
    const { step } = geometry();
    const tr = track.getBoundingClientRect();
    const center = tr.left + tr.width / 2;
    cards.forEach((card) => {
      const cr = card.getBoundingClientRect();
      const dist = Math.abs(cr.left + cr.width / 2 - center) / step;
      card.style.opacity = String(Math.max(0.35, 1 - 0.28 * dist));
    });
  }

  track.addEventListener('scroll', () => {
    const nearest = nearestIdx(track.scrollLeft);

    if (animating !== null) {
      if (Math.abs(track.scrollLeft - animating) <= 1) {
        animating = null;
        if (nearest === cloneLast) teleport(lastReal, realCount - 1);
        else if (nearest === cloneFirst) teleport(2, 0);
      }
    } else if (nearest <= cloneLast) {
      teleport(lastReal, realCount - 1);
    } else if (nearest >= cloneFirst) {
      teleport(2, 0);
    } else {
      currentReal = nearest - 2;
    }
    update();
    applyDepth();
  }, { passive: true });

  cards.forEach((card) => {
    card.addEventListener('click', (event) => {
      if (animating !== null) return;
      if ((event.target as HTMLElement).closest('a')) return;
      const tr = track.getBoundingClientRect();
      const cr = card.getBoundingClientRect();
      const cardCenter = cr.left + cr.width / 2;
      const trackCenter = tr.left + tr.width / 2;
      if (cardCenter > trackCenter + 1) goNext();
      else if (cardCenter < trackCenter - 1) goPrev();
    });
  });

  prevBtn.addEventListener('click', goPrev);
  nextBtn.addEventListener('click', goNext);

  window.addEventListener('resize', () => {
    track.scrollTo({ left: snapLeft(currentReal + 2), behavior: 'instant' });
  });

  track.scrollTo({ left: snapLeft(2), behavior: 'instant' });
  applyDepth();
  update();
</script>